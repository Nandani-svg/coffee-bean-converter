{
"manifest_version": 3,
"name": "Coffee Bean Rate",
"version": "1.0.0",
"description": "Convert prices on e commerce pages into coffee beans. $1 = 1 bean.",
"action": {
    "default_popup": "popup.html"
},
"permissions": [
"storage",
"activeTab"
],
"host_permissions": [
"*://*/*"
],
"web_accessible_resources": [
{
"resources": ["icons/bean.jpg"],
"matches": ["*://*/*"]
}
],
"content_scripts": [
{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_idle"
}
]
}